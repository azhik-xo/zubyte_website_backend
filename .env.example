# Zubyte Backend Environment Variables
NODE_ENV=development
PORT=5000

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/zubyte_db

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# JWT Authentication Secret
JWT_SECRET=zubyte_jwt_super_secret_production_key_2026_x99!
JWT_EXPIRE=7d

# Cloudinary Integration (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Upload Settings
MAX_FILE_SIZE_MB=15
UPLOAD_DIR=uploads
