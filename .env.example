# Zubyte Backend Environment Variables
NODE_ENV=development
PORT=5000

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/zubyte_db

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# JWT Authentication Secret
JWT_SECRET=zubyte_jwt_super_secret_production_key_2026_x99!
JWT_EXPIRE=7d

# Storage Settings (MongoDB GridFS)
# Images and document attachments are stored directly in MongoDB via GridFS
MAX_FILE_SIZE_MB=10
